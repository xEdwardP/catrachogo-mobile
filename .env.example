# Copiar a .env y ajustar. Expo solo expone al bundle las variables con prefijo EXPO_PUBLIC_*.
#
# - Web / iOS Simulator: http://localhost:3000 funciona tal cual.
# - Emulador Android: usar http://10.0.2.2:3000 (localhost del emulador no apunta a la máquina host).
# - Dispositivo físico (Expo Go / dev client): usar la IP de red local de la máquina, ej. http://192.168.1.50:3000.
#
# El backend (catrachogo-api) no usa prefijo /api — las rutas cuelgan directo de la raíz (ver docs/mobile-api-guide.md).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Maps Platform — key restringida por package name (Android) / bundle ID (iOS), usada por
# el SDK nativo del mapa (react-native-maps). Ver CLAUDE.md para los pasos de creación.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=

# Google Places API (New) + Directions API — key SIN restricción de aplicación (solo restringida
# por API), distinta de las de arriba. La restricción "Android/iOS apps" bloquea las llamadas REST
# crudas que hace el autocompletado de direcciones y el trazado de ruta (confirmado en vivo, no
# teórico) — ver docs/stack-tecnico-mobile.md, sección Autocompletado.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Google Sign-In — client ID propio de mobile, distinto al de catrachogo-web.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Cloudinary — mismo cloud name y upload preset unsigned que ya usa catrachogo-web.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# PayPal — mismo client ID que ya usa catrachogo-web (checkout vía WebView, ver stack-tecnico-mobile.md).
EXPO_PUBLIC_PAYPAL_CLIENT_ID=

# Correo de soporte mostrado en la pantalla de Ayuda (mismo que usa catrachogo-web).
EXPO_PUBLIC_SUPPORT_EMAIL=soportemacaw@gmail.com
